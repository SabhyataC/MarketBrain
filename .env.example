MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.1
IMAGE_MODEL_NAME=muse-image-1.0

# Spending limits, in Rs per day
MAX_DAILY_BUDGET=500
MAX_TOTAL_DAILY_BUDGET=1000

# Cost per model call, in credits or money (leave 0 if you do not know it yet).
# Used for the cost numbers in the Report card and in eval/run_eval.py.
COST_TEXT=0
COST_VISION=0
COST_IMAGE=0

# Send products to a shop (all optional; products always arrive as drafts)
# Your own site (Django, FastAPI, PHP...): see docs/django_receiver.py
WEBHOOK_URL=
WEBHOOK_SECRET=
# Shopify: store like my-store.myshopify.com, token from a custom app with product write access
SHOPIFY_STORE=
SHOPIFY_TOKEN=
# WooCommerce: site address and REST API key/secret (WooCommerce > Settings > Advanced > REST API)
WOO_URL=
WOO_KEY=
WOO_SECRET=
# Public address where your product photos are hosted (optional; photos are local otherwise)
SYNC_IMAGE_BASE=

# SEO engine (all optional)
# Length limits in characters
SEO_TITLE_MAX=60
SEO_DESC_MAX=155
SEO_H1_MAX=70
SEO_ALT_MAX=125
# WooCommerce only: which SEO plugin holds the title and description (yoast or rankmath)
SEO_PLUGIN=
